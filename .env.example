# ==============================================================================
# SUKABUMI EUNDEUR — CENTRALIZED ENVIRONMENT VARIABLES (.env.example)
# Single Source of Truth for Local & VPS Self-Hosted Deployment
# ==============================================================================

# 1. APP CORE CONFIGURATION
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Sukabumi Eundeur"
NEXT_PUBLIC_APP_ENV="development" # development | staging | production

# 2. SELF-HOSTED POSTGRESQL DATABASE
POSTGRES_USER="postgres_admin"
POSTGRES_PASSWORD="postgres_secret_key_2026"
POSTGRES_DB="sukabumi_eundeur_db"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://postgres_admin:postgres_secret_key_2026@127.0.0.1:5432/sukabumi_eundeur_db"

# 3. SELF-HOSTED REDIS LOCK & CACHE
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD="redis_secret_key_2026"
REDIS_URL="redis://:redis_secret_key_2026@127.0.0.1:6379"

# 4. PAYMENT GATEWAY (MIDTRANS)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-your-client-key"
MIDTRANS_SERVER_KEY="SB-Mid-server-your-server-key"
MIDTRANS_IS_PRODUCTION="false"

# 5. SECURITY SECRETS
JWT_SECRET="your-jwt-auth-secret-key-2026"
MIDTRANS_WEBHOOK_SECRET="your-midtrans-webhook-signature-secret"
CRON_SECRET_KEY="your-random-cron-authorization-secret"
